# Copy to .streamlit/secrets.toml for local dev, or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets for deployment.
# DO NOT commit the real secrets.toml (it is gitignored).

# --- LLM (free options, no credit card) ---
# Groq (default): sign up at https://console.groq.com -> API Keys
LLM_API_KEY = "gsk_..."
# LLM_BASE_URL = "https://api.groq.com/openai/v1"
# LLM_MODEL = "llama-3.3-70b-versatile"
#
# Google Gemini instead:
# LLM_API_KEY  = "AIza..."   (from https://aistudio.google.com/apikey)
# LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
# LLM_MODEL    = "gemini-2.5-flash"

# --- monday.com ---
MONDAY_API_TOKEN = "your-monday-personal-api-token"
MONDAY_DEALS_BOARD_ID = "0000000000"
MONDAY_WORK_ORDERS_BOARD_ID = "0000000000"
# MONDAY_API_VERSION = "2024-10"

# CACHE_TTL_SECONDS = "300"
# MAX_AGENT_STEPS = "10"

# Dev only. Leave unset in production so the agent queries monday.com.
# SKY_DATA_SOURCE = "csv"
